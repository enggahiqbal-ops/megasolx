# Sanity — public (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID="cxr8q1di"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Base URL used by the embedded Studio's Presentation tool.
# In production set this to https://your-domain.com/studio
